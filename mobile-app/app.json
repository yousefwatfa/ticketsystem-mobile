{
  "expo": {
    "name": "الدعم الفني",
    "slug": "nmc-tickets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nmctickets",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ps.gov.nmc.tickets",
      "supportsTablet": true,
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "package": "ps.gov.nmc.tickets",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "يستخدم التطبيق الكاميرا لتصوير المشكلة وإرفاقها بالتذكرة.",
          "photosPermission": "يستخدم التطبيق الصور لإرفاقها بالتذكرة.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {}
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0077C2",
          "defaultChannel": "tickets"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "forcesRTL": true,
      "eas": {
        "projectId": "8aa4871a-a4a1-4f6b-bb2c-45e6c2659fb3"
      }
    },
    "owner": "yousefwatfa"
  }
}
